<Window
    x:Class="EzyImageViewer.App.Views.ViewerWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:skia="using:SkiaSharp.Views.Windows"
    Title="ezy Image Viewer">
    <Grid x:Name="Root">
        <Grid.Resources>
            <ResourceDictionary>
                <ResourceDictionary.MergedDictionaries>
                    <ResourceDictionary Source="ms-appx:///Resources/Icons.xaml" />
                </ResourceDictionary.MergedDictionaries>
            </ResourceDictionary>
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="0" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Left rail per UI디자인.png (ADR-0002). -->
            <Border
                x:Name="ToolRail"
                Grid.ColumnSpan="2"
                Margin="12"
                Padding="4,8"
                HorizontalAlignment="Left"
                VerticalAlignment="Stretch"
                Background="{ThemeResource AcrylicInAppFillColorDefaultBrush}"
                CornerRadius="12"
                Canvas.ZIndex="20">
                <Grid x:Name="ToolRailViewport">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Button x:Name="DockToggleButton" Grid.Row="0" Grid.Column="0" Click="OnDockToggleClicked" Style="{StaticResource RailButtonStyle}"><IconSourceElement IconSource="{StaticResource Icon.Layout.SwitchOrientation}" Style="{StaticResource ToolIconStyle}" /></Button>
                    <Border x:Name="DockMenuSeparator" Grid.Row="1" Grid.Column="0" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />
                    <Grid x:Name="ToolRailScrollableViewport" Grid.Row="2" Grid.Column="0">
                        <ScrollViewer x:Name="ToolRailScroll" VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel x:Name="ToolRailItems" Orientation="Vertical">
                    <StackPanel x:Name="FileToolGroup" Orientation="Vertical" Spacing="2">
                        <Button x:Name="OpenButton" Click="OnOpenClicked" Style="{StaticResource RailButtonStyle}"><IconSourceElement IconSource="{StaticResource Icon.File.Open}" Style="{StaticResource ToolIconStyle}" /></Button>
                        <Button x:Name="RecentButton" Click="OnRecentClicked" Style="{StaticResource RailButtonStyle}"><IconSourceElement IconSource="{StaticResource Icon.File.Recent}" Style="{StaticResource ToolIconStyle}" /></Button>
                        <Button x:Name="ClipboardButton" Click="OnClipboardClicked" Style="{StaticResource RailButtonStyle}"><IconSourceElement IconSource="{StaticResource Icon.File.Clipboard}" Style="{StaticResource ToolIconStyle}" /></Button>
                        <Button x:Name="CaptureButton" Click="OnCaptureClicked" Style="{StaticResource RailButtonStyle}"><IconSourceElement IconSource="{StaticResource Icon.File.Capture}" Style="{StaticResource ToolIconStyle}" /></Button>
                        <Button x:Name="NewWindowButton" Click="OnNewWindowClicked" Style="{StaticResource RailButtonStyle}"><IconSourceElement IconSource="{StaticResource Icon.File.NewWindow}" Style="{StaticResource ToolIconStyle}" /></Button>
                        <Button x:Name="SaveButton" Click="OnSaveClicked" Style="{StaticResource RailButtonStyle}"><IconSourceElement IconSource="{StaticResource Icon.File.Save}" Style="{StaticResource ToolIconStyle}" /></Button>
                    </StackPanel>
                    <Border x:Name="FileHistorySeparator" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />
                    <StackPanel x:Name="HistoryToolGroup" Orientation="Vertical" Spacing="2">
                        <Button x:Name="UndoButton" Click="OnUndoClicked" Style="{StaticResource RailButtonStyle}"><IconSourceElement IconSource="{StaticResource Icon.History.Undo}" Style="{StaticResource ToolIconStyle}" /></Button>
                        <Button x:Name="RedoButton" Click="OnRedoClicked" Style="{StaticResource RailButtonStyle}"><IconSourceElement IconSource="{StaticResource Icon.History.Redo}" Style="{StaticResource ToolIconStyle}" /></Button>
                    </StackPanel>
                    <Border x:Name="HistoryImageSeparator" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />
                    <StackPanel x:Name="ImageToolGroup" Orientation="Vertical" Spacing="2">
                        <ToggleButton x:Name="SelectButton" Tag="Select" Click="OnAnnotationToolClicked" Style="{StaticResource RailToggleStyle}"><IconSourceElement IconSource="{StaticResource Icon.Image.Select}" Style="{StaticResource ToolIconStyle}" /></ToggleButton>
                        <ToggleButton x:Name="CropButton" Click="OnCropClicked" Style="{StaticResource RailToggleStyle}"><IconSourceElement IconSource="{StaticResource Icon.Image.Crop}" Style="{StaticResource ToolIconStyle}" /></ToggleButton>
                        <Button x:Name="CropRatioButton" Click="OnCropRatioClicked" Style="{StaticResource RailButtonStyle}"><IconSourceElement IconSource="{StaticResource Icon.Image.CropRatio}" Style="{StaticResource ToolIconStyle}" /></Button>
                        <Button x:Name="ResizeButton" Click="OnResizeClicked" Style="{StaticResource RailButtonStyle}"><IconSourceElement IconSource="{StaticResource Icon.Image.Resize}" Style="{StaticResource ToolIconStyle}" /></Button>
                        <Button x:Name="RotateButton" Click="OnRotateClicked" Style="{StaticResource RailButtonStyle}"><IconSourceElement IconSource="{StaticResource Icon.Image.Rotate}" Style="{StaticResource ToolIconStyle}" /></Button>
                        <Button x:Name="FlipHorizontalButton" Click="OnFlipHorizontalClicked" Style="{StaticResource RailButtonStyle}"><IconSourceElement IconSource="{StaticResource Icon.Image.FlipHorizontal}" Style="{StaticResource ToolIconStyle}" /></Button>
                        <Button x:Name="FlipVerticalButton" Click="OnFlipVerticalClicked" Style="{StaticResource RailButtonStyle}"><IconSourceElement IconSource="{StaticResource Icon.Image.FlipVertical}" Style="{StaticResource ToolIconStyle}" RenderTransformOrigin="0.5,0.5"><IconSourceElement.RenderTransform><RotateTransform Angle="90" /></IconSourceElement.RenderTransform></IconSourceElement></Button>
                    </StackPanel>
                    <Border x:Name="ImageDrawingSeparator" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />
                    <StackPanel x:Name="DrawingToolGroup" Orientation="Vertical" Spacing="2">
                        <ToggleButton x:Name="PenButton" Tag="Pen" Click="OnAnnotationToolClicked" Style="{StaticResource RailToggleStyle}"><IconSourceElement IconSource="{StaticResource Icon.Draw.Pen}" Style="{StaticResource ToolIconStyle}" /></ToggleButton>
                        <ToggleButton x:Name="HighlighterButton" Tag="Highlighter" Click="OnAnnotationToolClicked" Style="{StaticResource RailToggleStyle}"><IconSourceElement IconSource="{StaticResource Icon.Draw.Highlighter}" Style="{StaticResource ToolIconStyle}" /></ToggleButton>
                        <ToggleButton x:Name="LineButton" Tag="Line" Click="OnAnnotationToolClicked" Style="{StaticResource RailToggleStyle}"><IconSourceElement IconSource="{StaticResource Icon.Draw.Line}" Style="{StaticResource ToolIconStyle}" /></ToggleButton>
                        <ToggleButton x:Name="ArrowButton" Tag="Arrow" Click="OnAnnotationToolClicked" Style="{StaticResource RailToggleStyle}"><IconSourceElement IconSource="{StaticResource Icon.Draw.Arrow}" Style="{StaticResource ToolIconStyle}" /></ToggleButton>
                        <Button x:Name="ColorButton" Style="{StaticResource RailButtonStyle}">
                        <Button.Flyout>
                            <Flyout x:Name="ColorFlyout">
                                <Border Padding="8">
                                    <Grid x:Name="ColorGrid" RowSpacing="4" ColumnSpacing="4">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                    </Grid>
                                </Border>
                            </Flyout>
                        </Button.Flyout>
                            <Grid><IconSourceElement IconSource="{StaticResource Icon.Draw.ColorPalette}" Style="{StaticResource ToolIconStyle}" /><Border x:Name="CurrentColorSwatch" Width="12" Height="12" HorizontalAlignment="Right" VerticalAlignment="Bottom" CornerRadius="6" BorderThickness="2" /></Grid>
                        </Button>
                        <ToggleButton x:Name="EyedropperButton" Tag="Eyedropper" Click="OnAnnotationToolClicked" Style="{StaticResource RailToggleStyle}"><IconSourceElement IconSource="{StaticResource Icon.Draw.Eyedropper}" Style="{StaticResource ToolIconStyle}" /></ToggleButton>
                    </StackPanel>
                    <Border x:Name="DrawingShapeSeparator" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />
                    <StackPanel x:Name="ShapeToolGroup" Orientation="Vertical" Spacing="2">
                        <ToggleButton x:Name="RectangleButton" Tag="Rectangle" Click="OnAnnotationToolClicked" Style="{StaticResource RailToggleStyle}"><IconSourceElement IconSource="{StaticResource Icon.Shape.Rectangle}" Style="{StaticResource ToolIconStyle}" /></ToggleButton>
                        <ToggleButton x:Name="RoundedRectangleButton" Tag="RoundedRectangle" Click="OnAnnotationToolClicked" Style="{StaticResource RailToggleStyle}"><IconSourceElement IconSource="{StaticResource Icon.Shape.RoundedRectangle}" Style="{StaticResource ToolIconStyle}" /></ToggleButton>
                        <ToggleButton x:Name="EllipseButton" Tag="Ellipse" Click="OnAnnotationToolClicked" Style="{StaticResource RailToggleStyle}"><IconSourceElement IconSource="{StaticResource Icon.Shape.Ellipse}" Style="{StaticResource ToolIconStyle}" /></ToggleButton>
                        <ToggleButton x:Name="NumberButton" Tag="Number" Click="OnAnnotationToolClicked" Style="{StaticResource RailToggleStyle}"><IconSourceElement IconSource="{StaticResource Icon.Shape.Number}" Style="{StaticResource ToolIconStyle}" /></ToggleButton>
                    </StackPanel>
                    <Border x:Name="ShapeTextSeparator" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />
                    <StackPanel x:Name="TextToolGroup" Orientation="Vertical" Spacing="2">
                        <ToggleButton x:Name="TextButton" Tag="Text" Click="OnAnnotationToolClicked" Style="{StaticResource RailToggleStyle}"><IconSourceElement IconSource="{StaticResource Icon.Text.Text}" Style="{StaticResource ToolIconStyle}" /></ToggleButton>
                    </StackPanel>
                    <Border x:Name="TextProtectionSeparator" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />
                    <StackPanel x:Name="ProtectionToolGroup" Orientation="Vertical" Spacing="2">
                        <ToggleButton x:Name="MosaicButton" Tag="Mosaic" Click="OnAnnotationToolClicked" Style="{StaticResource RailToggleStyle}"><IconSourceElement IconSource="{StaticResource Icon.Protect.Mosaic}" Style="{StaticResource ToolIconStyle}" /></ToggleButton>
                        <ToggleButton x:Name="BlurButton" Tag="Blur" Click="OnAnnotationToolClicked" Style="{StaticResource RailToggleStyle}"><IconSourceElement IconSource="{StaticResource Icon.Protect.Blur}" Style="{StaticResource ToolIconStyle}" /></ToggleButton>
                        <ToggleButton x:Name="MaskButton" Tag="Mask" Click="OnAnnotationToolClicked" Style="{StaticResource RailToggleStyle}"><IconSourceElement IconSource="{StaticResource Icon.Protect.Mask}" Style="{StaticResource ToolIconStyle}" /></ToggleButton>
                    </StackPanel>
                    <Border x:Name="ProtectionViewSeparator" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />
                    <StackPanel x:Name="ViewToolGroup" Orientation="Vertical" Spacing="2">
                        <Button x:Name="FitButton" Click="OnFitClicked" Style="{StaticResource RailButtonStyle}"><IconSourceElement IconSource="{StaticResource Icon.View.Fit}" Style="{StaticResource ToolIconStyle}" /></Button>
                        <Button x:Name="ActualSizeButton" Click="OnActualSizeClicked" Style="{StaticResource RailButtonStyle}"><IconSourceElement IconSource="{StaticResource Icon.View.ActualSize}" Style="{StaticResource ToolIconStyle}" /></Button>
                        <ToggleButton x:Name="LayerPanelButton" Click="OnLayerPanelToggleClicked" Style="{StaticResource RailToggleStyle}"><IconSourceElement IconSource="{StaticResource Icon.View.LayerPanel}" Style="{StaticResource ToolIconStyle}" /></ToggleButton>
                        <Button x:Name="SettingsButton" Click="OnSettingsClicked" Style="{StaticResource RailButtonStyle}"><IconSourceElement IconSource="{StaticResource Icon.App.Settings}" Style="{StaticResource ToolIconStyle}" /></Button>
                    </StackPanel>
                            </StackPanel>
                        </ScrollViewer>
                        <Border
                            x:Name="ToolRailStartOverflowHint"
                            Height="22"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Top"
                            IsHitTestVisible="False"
                            Opacity="0.72"
                            Visibility="Collapsed"
                            AutomationProperties.AutomationId="ToolRailStartOverflowHint"
                            AutomationProperties.AccessibilityView="Raw" />
                        <Border
                            x:Name="ToolRailEndOverflowHint"
                            Height="22"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Bottom"
                            IsHitTestVisible="False"
                            Opacity="0.72"
                            Visibility="Collapsed"
                            AutomationProperties.AutomationId="ToolRailEndOverflowHint"
                            AutomationProperties.AccessibilityView="Raw" />
                    </Grid>
                </Grid>
            </Border>

            <Border
                x:Name="LayerPanel"
                Grid.ColumnSpan="2"
                Margin="68,12,0,0"
                Padding="10"
                Width="240"
                MaxHeight="360"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Background="{ThemeResource AcrylicInAppFillColorDefaultBrush}"
                CornerRadius="10"
                Canvas.ZIndex="19"
                Visibility="Collapsed">
                <Grid RowSpacing="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid ColumnSpacing="6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="LayerPanelTitle" Text="레이어" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <Button x:Name="LayerAddButton" Grid.Column="1" Click="OnLayerAddClicked" Style="{StaticResource CompactIconButtonStyle}"><IconSourceElement IconSource="{StaticResource Icon.Layer.Add}" Style="{StaticResource ToolIconStyle}" /></Button>
                    </Grid>
                    <ListView
                        x:Name="LayerList"
                        Grid.Row="1"
                        MinHeight="44"
                        MaxHeight="260"
                        SelectionMode="Single"
                        SelectionChanged="OnLayerSelectionChanged" />
                    <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="2">
                        <Button x:Name="LayerUpButton" Click="OnLayerUpClicked" Style="{StaticResource CompactIconButtonStyle}"><IconSourceElement IconSource="{StaticResource Icon.Layer.Up}" Style="{StaticResource ToolIconStyle}" /></Button>
                        <Button x:Name="LayerDownButton" Click="OnLayerDownClicked" Style="{StaticResource CompactIconButtonStyle}"><IconSourceElement IconSource="{StaticResource Icon.Layer.Down}" Style="{StaticResource ToolIconStyle}" /></Button>
                        <Button x:Name="LayerRenameButton" Click="OnLayerRenameClicked" Style="{StaticResource CompactIconButtonStyle}"><IconSourceElement IconSource="{StaticResource Icon.Layer.Rename}" Style="{StaticResource ToolIconStyle}" /></Button>
                        <Button x:Name="LayerMoveSelectionButton" Click="OnLayerMoveSelectionClicked" Style="{StaticResource CompactIconButtonStyle}"><IconSourceElement IconSource="{StaticResource Icon.Layer.MoveSelection}" Style="{StaticResource ToolIconStyle}" /></Button>
                        <Button x:Name="LayerDeleteButton" Click="OnLayerDeleteClicked" Style="{StaticResource CompactIconButtonStyle}"><IconSourceElement IconSource="{StaticResource Icon.Layer.Delete}" Style="{StaticResource ToolIconStyle}" /></Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- GL swap chain per ADR-0007 (WP4 gate); background/checkerboard is drawn inside the canvas.
                 UI-thread paint is the project contract: snapshot swap/dispose relies on it (no render lease). -->
            <skia:SKSwapChainPanel
                x:Name="Canvas"
                Grid.Column="1"
                DrawInBackground="False"
                EnableRenderLoop="False"
                AllowDrop="True"
                DragOver="OnDragOver"
                Drop="OnDrop"
                PaintSurface="OnPaintSurface"
                PointerPressed="OnPointerPressed"
                PointerMoved="OnPointerMoved"
                PointerReleased="OnPointerReleased"
                PointerCaptureLost="OnPointerLost"
                PointerCanceled="OnPointerLost"
                PointerWheelChanged="OnPointerWheelChanged"
                DoubleTapped="OnCanvasDoubleTapped"
                IsDoubleTapEnabled="True"
                SizeChanged="OnCanvasSizeChanged"
                Canvas.ZIndex="0" />

            <!-- FR-CAP-003: unsolicited capture offer — an overlay, never a session hijack. -->
            <InfoBar
                x:Name="CaptureBar"
                Grid.Column="1"
                Margin="24,0,24,16"
                HorizontalAlignment="Center"
                VerticalAlignment="Bottom"
                Severity="Informational"
                IsClosable="True"
                IsOpen="False"
                Closed="OnCaptureBarClosed"
                Canvas.ZIndex="12">
                <InfoBar.ActionButton>
                    <Button x:Name="CaptureOpenButton" Click="OnCaptureOpenClicked" />
                </InfoBar.ActionButton>
            </InfoBar>

            <InfoBar
                x:Name="RecoveryAvailabilityBar"
                Grid.Column="1"
                Margin="24,0,24,84"
                HorizontalAlignment="Center"
                VerticalAlignment="Bottom"
                Severity="Warning"
                IsClosable="False"
                IsOpen="False"
                Canvas.ZIndex="12" />

            <InfoBar
                x:Name="DataProtectionBar"
                Grid.Column="1"
                Margin="24,0,24,152"
                HorizontalAlignment="Center"
                VerticalAlignment="Bottom"
                Severity="Error"
                IsClosable="False"
                IsOpen="False"
                Canvas.ZIndex="12" />

            <Border
                x:Name="AnnotationContextBar"
                Grid.Column="1"
                Margin="68,12,12,0"
                Padding="10,6"
                MaxWidth="480"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Top"
                Background="{ThemeResource AcrylicInAppFillColorDefaultBrush}"
                CornerRadius="6"
                Canvas.ZIndex="10">
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock x:Name="ToolContextLabel" VerticalAlignment="Center" FontWeight="SemiBold" />
                    <TextBlock x:Name="StrokeWidthLabel" Text="px" VerticalAlignment="Center" Opacity="0.7" />
                    <NumberBox
                        x:Name="StrokeWidthBox"
                        Width="76"
                        Minimum="1"
                        Maximum="1000"
                        Value="3"
                        SmallChange="1"
                        SpinButtonPlacementMode="Compact"
                        ValueChanged="OnStrokeWidthChanged" />
                    <TextBlock x:Name="BlockSizeLabel" VerticalAlignment="Center" Opacity="0.7" />
                    <NumberBox
                        x:Name="BlockSizeBox"
                        Width="76"
                        Minimum="2"
                        Maximum="1024"
                        Value="12"
                        SmallChange="1"
                        SpinButtonPlacementMode="Compact"
                        ValueChanged="OnBlockSizeChanged" />
                    <TextBlock x:Name="BlurSigmaLabel" VerticalAlignment="Center" Opacity="0.7" />
                    <NumberBox
                        x:Name="BlurSigmaBox"
                        Width="76"
                        Minimum="1"
                        Maximum="80"
                        Value="8"
                        SmallChange="1"
                        SpinButtonPlacementMode="Compact"
                        ValueChanged="OnBlurSigmaChanged" />
                    <TextBlock x:Name="OpacityLabel" Text="%" VerticalAlignment="Center" Opacity="0.7" />
                    <NumberBox
                        x:Name="OpacityBox"
                        Width="78"
                        Minimum="1"
                        Maximum="100"
                        Value="100"
                        SmallChange="5"
                        SpinButtonPlacementMode="Compact"
                        ValueChanged="OnOpacityChanged" />
                    <TextBlock x:Name="FontSizeLabel" Text="T" VerticalAlignment="Center" Opacity="0.7" />
                    <NumberBox
                        x:Name="FontSizeBox"
                        Width="78"
                        Minimum="6"
                        Maximum="10000"
                        Value="24"
                        SmallChange="1"
                        SpinButtonPlacementMode="Compact"
                        ValueChanged="OnFontSizeChanged" />
                    <CheckBox
                        x:Name="FillCheckBox"
                        VerticalAlignment="Center"
                        Click="OnFillChanged" />
                    <NumberBox
                        x:Name="CornerRadiusBox"
                        Width="76"
                        Minimum="0"
                        Maximum="1000000"
                        Value="8"
                        SmallChange="1"
                        SpinButtonPlacementMode="Compact"
                        ValueChanged="OnCornerRadiusChanged" />
                    <ComboBox
                        x:Name="ArrowheadBox"
                        Width="110"
                        SelectionChanged="OnArrowheadChanged" />
                    <TextBox
                        x:Name="FontFamilyBox"
                        Width="130"
                        MaxLength="128"
                        Text="Malgun Gothic"
                        TextChanged="OnFontFamilyChanged" />
                    <ToggleButton
                        x:Name="BoldButton"
                        Content="B"
                        FontWeight="Bold"
                        Click="OnTextStyleChanged" />
                    <ToggleButton
                        x:Name="ItalicButton"
                        Content="I"
                        FontStyle="Italic"
                        Click="OnTextStyleChanged" />
                    <ComboBox
                        x:Name="TextAlignmentBox"
                        Width="90"
                        SelectionChanged="OnTextAlignmentChanged" />
                    <CheckBox
                        x:Name="TextBackgroundCheckBox"
                        VerticalAlignment="Center"
                        Click="OnTextBackgroundChanged" />
                    <NumberBox
                        x:Name="ObjectRotationBox"
                        Width="84"
                        Minimum="0"
                        Maximum="359.9"
                        SmallChange="1"
                        SpinButtonPlacementMode="Compact"
                        ValueChanged="OnObjectRotationChanged" />
                    <Button x:Name="SendToBackButton" Style="{StaticResource CompactIconButtonStyle}" Click="OnSendToBackClicked"><IconSourceElement IconSource="{StaticResource Icon.Object.SendToBack}" Style="{StaticResource ToolIconStyle}" /></Button>
                    <Button x:Name="SendBackwardButton" Style="{StaticResource CompactIconButtonStyle}" Click="OnSendBackwardClicked"><IconSourceElement IconSource="{StaticResource Icon.Object.SendBackward}" Style="{StaticResource ToolIconStyle}" /></Button>
                    <Button x:Name="BringForwardButton" Style="{StaticResource CompactIconButtonStyle}" Click="OnBringForwardClicked"><IconSourceElement IconSource="{StaticResource Icon.Object.BringForward}" Style="{StaticResource ToolIconStyle}" /></Button>
                    <Button x:Name="BringToFrontButton" Style="{StaticResource CompactIconButtonStyle}" Click="OnBringToFrontClicked"><IconSourceElement IconSource="{StaticResource Icon.Object.BringToFront}" Style="{StaticResource ToolIconStyle}" /></Button>
                    <Button x:Name="DuplicateButton" Style="{StaticResource CompactIconButtonStyle}" Click="OnDuplicateClicked"><IconSourceElement IconSource="{StaticResource Icon.Object.Duplicate}" Style="{StaticResource ToolIconStyle}" /></Button>
                    <Button x:Name="EditTextButton" Style="{StaticResource CompactIconButtonStyle}" Click="OnEditSelectedTextClicked"><IconSourceElement IconSource="{StaticResource Icon.Object.EditText}" Style="{StaticResource ToolIconStyle}" /></Button>
                </StackPanel>
                </ScrollViewer>
            </Border>

            <TextBlock
                x:Name="OverlayMessage"
                Grid.Column="1"
                Margin="24"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                FontSize="14"
                TextWrapping="Wrap"
                Visibility="Collapsed" />
        </Grid>

        <Grid Grid.Row="1" MinHeight="44" Padding="8,4" ColumnSpacing="8" Background="{ThemeResource LayerFillColorDefaultBrush}">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <StackPanel x:Name="StatusNavigationGroup" Grid.Column="0" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                <Button x:Name="PreviousButton" Style="{StaticResource CompactIconButtonStyle}" Click="OnPreviousClicked"><IconSourceElement IconSource="{StaticResource Icon.View.Previous}" Style="{StaticResource ToolIconStyle}" /></Button>
                <TextBlock x:Name="StatusPosition" MinWidth="64" FontSize="12" VerticalAlignment="Center" TextAlignment="Center" />
                <Button x:Name="NextButton" Style="{StaticResource CompactIconButtonStyle}" Click="OnNextClicked"><IconSourceElement IconSource="{StaticResource Icon.View.Next}" Style="{StaticResource ToolIconStyle}" /></Button>
            </StackPanel>
            <Grid Grid.Column="1" ColumnSpacing="8">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <ScrollViewer x:Name="StatusDetailsScroll" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                    <StackPanel Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="2">
                            <Button x:Name="PreviousPageButton" Style="{StaticResource CompactIconButtonStyle}" Click="OnPreviousPageClicked" />
                            <TextBlock x:Name="StatusPage" MinWidth="72" FontSize="12" VerticalAlignment="Center" TextAlignment="Center" />
                            <Button x:Name="NextPageButton" Style="{StaticResource CompactIconButtonStyle}" Click="OnNextPageClicked" />
                            <Button x:Name="AnimationPlaybackButton" Style="{StaticResource CompactIconButtonStyle}" Click="OnAnimationPlaybackClicked" Visibility="Collapsed">
                                <IconSourceElement x:Name="AnimationPlaybackIcon" Style="{StaticResource ToolIconStyle}" />
                            </Button>
                        </StackPanel>
                        <TextBlock x:Name="StatusDimensions" FontSize="12" />
                        <TextBlock x:Name="StatusFormat" FontSize="12" />
                        <TextBlock x:Name="StatusColorMode" FontSize="12" />
                        <TextBlock x:Name="StatusFileSize" FontSize="12" />
                        <TextBlock x:Name="StatusModified" FontSize="12" FontWeight="SemiBold" />
                    </StackPanel>
                </ScrollViewer>
                <TextBlock x:Name="StatusState" Grid.Column="1" Width="160" FontSize="12" Opacity="0.8" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                <ProgressRing x:Name="StatusProgress" Grid.Column="2" Width="20" Height="20" IsActive="False" />
            </Grid>
            <StackPanel x:Name="StatusZoomGroup" Grid.Column="2" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                <Button x:Name="ZoomOutButton" Style="{StaticResource CompactIconButtonStyle}" Click="OnZoomOutClicked"><IconSourceElement IconSource="{StaticResource Icon.View.ZoomOut}" Style="{StaticResource ToolIconStyle}" /></Button>
                <TextBlock x:Name="StatusZoom" MinWidth="42" FontSize="12" VerticalAlignment="Center" TextAlignment="Center" />
                <Button x:Name="ZoomInButton" Style="{StaticResource CompactIconButtonStyle}" Click="OnZoomInClicked"><IconSourceElement IconSource="{StaticResource Icon.View.ZoomIn}" Style="{StaticResource ToolIconStyle}" /></Button>
                <Slider x:Name="ZoomSlider" Width="120" Minimum="5" Maximum="3200" StepFrequency="5" />
                <Button x:Name="FullScreenButton" Style="{StaticResource CompactIconButtonStyle}" Click="OnFullScreenClicked"><IconSourceElement IconSource="{StaticResource Icon.View.FullScreen}" Style="{StaticResource ToolIconStyle}" /></Button>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
