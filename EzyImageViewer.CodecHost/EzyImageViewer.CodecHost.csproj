<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>EzyImageViewer.CodecHost</RootNamespace>
    <AssemblyName>EzyImageViewer.CodecHost</AssemblyName>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <InvariantGlobalization>true</InvariantGlobalization>
    <UseAppHost>true</UseAppHost>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\EzyImageViewer.CodecProtocol\EzyImageViewer.CodecProtocol.csproj" />
    <PackageReference Include="PDFtoImage" />
    <PackageReference Include="Magick.NET-Q8-AnyCPU" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\LICENSE" Link="LICENSE.txt" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\THIRD-PARTY-NOTICES.md"
             Link="THIRD-PARTY-NOTICES.md"
             CopyToOutputDirectory="PreserveNewest" />
    <!-- Version-pinned PDFium/Chromium notice set redistributed with pdfium.dll. -->
    <Content Include="Notices\**\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
