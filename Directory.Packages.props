<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>false</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>
  <ItemGroup>
    <!-- 2.x WinUI는 Engineering Preview 라이선스(live operating environment 금지)라 Store 배포 불가.
         1.8 라인은 정식 라이선스이며 WinUI를 [1.8.260709004]로 정확히 고정한다. 올리기 전 license.txt 확인 필수. -->
    <PackageVersion Include="Microsoft.WindowsAppSDK" Version="1.8.260710003" />
    <PackageVersion Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.28000.2270" />
    <PackageVersion Include="SkiaSharp" Version="4.150.1" />
    <PackageVersion Include="SkiaSharp.HarfBuzz" Version="4.150.1" />
    <PackageVersion Include="SkiaSharp.Views.WinUI" Version="4.150.1" />
    <!-- 테스트 -->
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.8.1" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.5" />
    <!-- 테스트 픽스처 생성 전용. 제품 어셈블리는 참조하지 않음. -->
    <PackageVersion Include="Magick.NET-Q8-AnyCPU" Version="14.15.0" />
    <!-- ADR-0005에서 채택한 M0-B 포맷 스파이크 후보. -->
    <PackageVersion Include="Svg.Skia" Version="5.1.1" />
  </ItemGroup>
</Project>
