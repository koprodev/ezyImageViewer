<?xml version="1.0" encoding="utf-8"?>
<!-- External-location identity package. The generator resolves all template attributes. -->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:uap10="http://schemas.microsoft.com/appx/manifest/uap/windows10/10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap uap10">

  <Identity Name="GRTech.ezyImageViewer"
            Publisher="{{PUBLISHER}}"
            Version="{{VERSION}}"
            ProcessorArchitecture="neutral" />

  <Properties>
    <DisplayName>ezy Image Viewer</DisplayName>
    <PublisherDisplayName>grtech-devpro</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
    <uap10:AllowExternalContent>true</uap10:AllowExternalContent>
  </Properties>

  <Resources>
    <Resource Language="ko-KR" />
  </Resources>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop"
                        MinVersion="{{MIN_VERSION}}"
                        MaxVersionTested="10.0.26100.0" />
    <PackageDependency Name="GRTech.ezyImageViewer.CodecHost"
                       Publisher="{{PUBLISHER}}"
                       MinVersion="{{CODEC_HOST_VERSION}}" />
  </Dependencies>

  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
    <rescap:Capability Name="unvirtualizedResources" />
  </Capabilities>

  <Applications>
    <Application Id="App"
                 Executable="ezyImageViewer.exe"
                 uap10:TrustLevel="mediumIL"
                 uap10:RuntimeBehavior="win32App">
      <uap:VisualElements DisplayName="ezy Image Viewer"
                          Description="ezy Image Viewer"
                          BackgroundColor="transparent"
                          Square150x150Logo="Assets\Square150x150Logo.png"
                          Square44x44Logo="Assets\Square44x44Logo.png"
                          AppListEntry="none" />
      <Extensions>
        <uap:Extension Category="windows.protocol">
          <uap:Protocol Name="ezyimageviewer" DesiredView="default">
            <uap:DisplayName>ezy Image Viewer</uap:DisplayName>
          </uap:Protocol>
        </uap:Extension>
      </Extensions>
    </Application>
  </Applications>
</Package>
