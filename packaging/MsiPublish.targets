<Project>
  <!-- 네이티브 종속성 기호는 런타임 자산이라 일반 DebugSymbols 속성으로 빠지지 않음.
       게시 해석 뒤 걸러 복사 페이로드와 PublishOutputs 목록을 맞춤. -->
  <Target Name="EzyFilterMsiPublishSymbols" AfterTargets="ComputeFilesToPublish">
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)"
                             Condition="'%(ResolvedFileToPublish.Extension)' == '.pdb'" />
      <ResolvedFileToPublish Include="$(ProjectPriFullPath)"
                             Exclude="@(ResolvedFileToPublish)"
                             Condition="Exists('$(ProjectPriFullPath)')">
        <RelativePath>$(ProjectPriFileName)</RelativePath>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      </ResolvedFileToPublish>
    </ItemGroup>
  </Target>
</Project>
