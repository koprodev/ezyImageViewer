<Project Sdk="WixToolset.Sdk/7.0.0">
  <PropertyGroup>
    <AcceptEula>wix7</AcceptEula>
    <InstallerPlatform>x64</InstallerPlatform>
    <OutputType>Bundle</OutputType>
    <OutputName>ezyImageViewerSetup-$(ProductVersion)-x64</OutputName>
    <!-- The per-machine MSI is conditioned on the configurable bundle's planned scope. -->
    <SuppressSpecificWarnings>$(SuppressSpecificWarnings);1140</SuppressSpecificWarnings>
    <ProductVersion Condition="'$(ProductVersion)' == ''">1.0.0</ProductVersion>
    <DefineConstants>$(DefineConstants);ProductVersion=$(ProductVersion);PerUserMsi=$(PerUserMsi);PerMachineMsi=$(PerMachineMsi);ScopeAnchorMsi=$(ScopeAnchorMsi);EulaRtf=$(EulaRtf);BundleIcon=$(BundleIcon);BundleLogo=$(BundleLogo);ThemeFile=$(ThemeFile)</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="WixToolset.BootstrapperApplications.wixext" />
  </ItemGroup>
</Project>
