<Project Sdk="WixToolset.Sdk/7.0.0">
  <PropertyGroup>
    <AcceptEula>wix7</AcceptEula>
    <InstallerPlatform>x64</InstallerPlatform>
    <OutputType>Bundle</OutputType>
    <OutputName>ezyImageViewerSetup-$(ProductVersion)-x64</OutputName>
    <EnableDefaultEmbeddedResourceItems>false</EnableDefaultEmbeddedResourceItems>
    <!-- 고정 범위 MSI는 WixStdBA의 구성 가능 범위 변수로 선택. -->
    <SuppressSpecificWarnings>$(SuppressSpecificWarnings);1140</SuppressSpecificWarnings>
    <ProductVersion Condition="'$(ProductVersion)' == ''">1.0.0</ProductVersion>
    <DefineConstants>$(DefineConstants);ProductVersion=$(ProductVersion);PerUserMsi=$(PerUserMsi);PerMachineMsi=$(PerMachineMsi);EulaRtf=$(EulaRtf);KoreanEula=$(KoreanEula);BundleLocalization=$(BundleLocalization);KoreanLocalization=$(KoreanLocalization);BundleIcon=$(BundleIcon);BundleLogo=$(BundleLogo);ThemeFile=$(ThemeFile)</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="WixToolset.BootstrapperApplications.wixext" />
  </ItemGroup>
</Project>
