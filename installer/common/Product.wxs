<?xml version="1.0" encoding="utf-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">
  <Package Name="ezy Image Viewer"
           Manufacturer="koprodev"
           Version="$(var.ProductVersion)"
           Language="1042"
           Codepage="65001"
           Scope="$(var.InstallerScope)"
           UpgradeCode="$(var.UpgradeCode)"
           InstallerVersion="500"
           Compressed="yes">
    <MediaTemplate EmbedCab="yes" />
    <MajorUpgrade DowngradeErrorMessage="더 최신 버전의 ezy Image Viewer가 이미 설치되어 있습니다." />

    <Property Id="WINDOWSBUILD">
      <RegistrySearch Id="WindowsBuildSearch"
                      Root="HKLM"
                      Key="SOFTWARE\Microsoft\Windows NT\CurrentVersion"
                      Name="CurrentBuildNumber"
                      Type="raw"
                      Bitness="always64" />
    </Property>
    <Launch Condition="VersionNT64 AND WINDOWSBUILD &gt;= 19041"
            Message="ezy Image Viewer는 Windows 10 build 19041 이상의 x64 Windows가 필요합니다." />

    <Property Id="EZY_DESKTOP_SHORTCUT" Secure="yes" Value="0" />
    <Property Id="EZY_FILE_ASSOCIATIONS" Secure="yes" Value="0" />
    <Property Id="ApplicationFolderName" Value="ezy Image Viewer" />
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOX" Value="1" />
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOXTEXT"
              Value="설치 후 ezy Image Viewer 실행" />
    <Property Id="WixUnelevatedShellExecTarget" Value="[#ApplicationExecutable]" />

    <?if $(var.InstallerScope) = perUser ?>
      <Property Id="WixAppFolder" Value="WixPerUserFolder" />
      <WixVariable Id="override WixUISupportPerMachine" Value="0" />
      <StandardDirectory Id="LocalAppDataFolder">
        <Directory Id="LocalProgramsFolder" Name="Programs">
          <Directory Id="APPLICATIONFOLDER" Name="ezy Image Viewer" />
        </Directory>
      </StandardDirectory>
    <?else?>
      <Property Id="WixAppFolder" Value="WixPerMachineFolder" />
      <WixVariable Id="override WixUISupportPerUser" Value="0" />
      <StandardDirectory Id="ProgramFiles64Folder">
        <Directory Id="APPLICATIONFOLDER" Name="ezy Image Viewer" />
      </StandardDirectory>
    <?endif?>

    <StandardDirectory Id="$(var.StartMenuRoot)">
      <Directory Id="ApplicationProgramsFolder" Name="ezy Image Viewer" />
    </StandardDirectory>

    <ComponentGroup Id="StartMenuComponents">
      <Component Id="StartMenuShortcutComponent"
                 Directory="ApplicationProgramsFolder"
                 Guid="$(var.StartMenuComponentGuid)">
        <Shortcut Id="StartMenuShortcut"
                  Name="ezy Image Viewer"
                  Description="ezy Image Viewer"
                  Target="[APPLICATIONFOLDER]ezyImageViewer.exe"
                  WorkingDirectory="APPLICATIONFOLDER" />
        <RemoveFolder Id="RemoveApplicationProgramsFolder" On="uninstall" />
        <RegistryValue Root="HKCU"
                       Key="Software\koprodev\ezy Image Viewer\Installer"
                       Name="StartMenuShortcut"
                       Type="integer"
                       Value="1"
                       KeyPath="yes" />
      </Component>
    </ComponentGroup>

    <ComponentGroup Id="DesktopShortcutComponents">
      <Component Id="DesktopShortcutComponent"
                 Directory="$(var.DesktopRoot)"
                 Guid="$(var.DesktopComponentGuid)">
        <Shortcut Id="DesktopShortcut"
                  Name="ezy Image Viewer"
                  Description="ezy Image Viewer"
                  Target="[APPLICATIONFOLDER]ezyImageViewer.exe"
                  WorkingDirectory="APPLICATIONFOLDER" />
        <RegistryValue Root="HKCU"
                       Key="Software\koprodev\ezy Image Viewer\Installer"
                       Name="DesktopShortcut"
                       Type="integer"
                       Value="1"
                       KeyPath="yes" />
      </Component>
    </ComponentGroup>

    <ComponentGroup Id="FileAssociationComponents">
      <Component Id="FileAssociationComponent"
                 Directory="APPLICATIONFOLDER"
                 Guid="$(var.FileAssociationComponentGuid)">
        <RegistryValue Root="$(var.RegistryRoot)" Key="Software\Classes\ezyImageViewer.Image"
                       Value="ezy Image Viewer Image" Type="string" KeyPath="yes" />
        <RegistryValue Root="$(var.RegistryRoot)" Key="Software\Classes\ezyImageViewer.Image\DefaultIcon"
                       Value="[APPLICATIONFOLDER]ezyImageViewer.exe,0" Type="string" />
        <RegistryValue Root="$(var.RegistryRoot)" Key="Software\Classes\ezyImageViewer.Image\shell\open\command"
                       Value="&quot;[APPLICATIONFOLDER]ezyImageViewer.exe&quot; &quot;%1&quot;" Type="string" />
        <RegistryValue Root="$(var.RegistryRoot)" Key="Software\koprodev\ezy Image Viewer\Capabilities"
                       Name="ApplicationName" Value="ezy Image Viewer" Type="string" />
        <RegistryValue Root="$(var.RegistryRoot)" Key="Software\koprodev\ezy Image Viewer\Capabilities"
                       Name="ApplicationDescription" Value="이미지 보기 및 편집" Type="string" />
        <?foreach extension in png;jpg;jpeg;bmp;gif;webp;tif;tiff?>
          <RegistryValue Root="$(var.RegistryRoot)"
                         Key="Software\Classes\.$(var.extension)\OpenWithProgids"
                         Name="ezyImageViewer.Image" Value="" Type="string" />
          <RegistryValue Root="$(var.RegistryRoot)"
                         Key="Software\koprodev\ezy Image Viewer\Capabilities\FileAssociations"
                         Name=".$(var.extension)" Value="ezyImageViewer.Image" Type="string" />
        <?endforeach?>
        <RegistryValue Root="$(var.RegistryRoot)" Key="Software\RegisteredApplications"
                       Name="ezy Image Viewer"
                       Value="Software\koprodev\ezy Image Viewer\Capabilities"
                       Type="string" />
      </Component>
    </ComponentGroup>

    <ComponentGroup Id="ApplicationRegistrationComponents">
      <Component Id="ApplicationPathComponent"
                 Directory="APPLICATIONFOLDER"
                 Guid="$(var.ApplicationPathComponentGuid)">
        <RegistryValue Root="$(var.RegistryRoot)"
                       Key="Software\Microsoft\Windows\CurrentVersion\App Paths\ezyImageViewer.exe"
                       Value="[APPLICATIONFOLDER]ezyImageViewer.exe"
                       Type="string"
                       KeyPath="yes" />
      </Component>
    </ComponentGroup>

    <Feature Id="Complete" Title="ezy Image Viewer" Level="1" AllowAbsent="no">
      <Feature Id="Core" Title="프로그램 파일" Level="1" AllowAbsent="no">
        <ComponentGroupRef Id="ApplicationPayload" />
        <ComponentGroupRef Id="ApplicationRegistrationComponents" />
      </Feature>
      <Feature Id="StartMenu" Title="시작 메뉴 바로가기" Level="1">
        <ComponentGroupRef Id="StartMenuComponents" />
      </Feature>
      <Feature Id="Desktop" Title="바탕 화면 바로가기" Level="2">
        <Level Value="1" Condition="EZY_DESKTOP_SHORTCUT = 1" />
        <ComponentGroupRef Id="DesktopShortcutComponents" />
      </Feature>
      <Feature Id="FileAssociations" Title="지원 이미지 형식 등록" Level="2">
        <Level Value="1" Condition="EZY_FILE_ASSOCIATIONS = 1" />
        <ComponentGroupRef Id="FileAssociationComponents" />
      </Feature>
    </Feature>

    <SetProperty Id="RollbackUnregisterIdentity"
                 Value="&quot;[System64Folder]WindowsPowerShell\v1.0\powershell.exe&quot; -NoProfile -NonInteractive -ExecutionPolicy Bypass -File &quot;[#IdentityRegistrationInvoker]&quot; -Action Register -Scope $(var.IdentityScope)"
                 Before="RollbackUnregisterIdentity" Sequence="execute" />
    <SetProperty Id="UnregisterIdentity"
                 Value="&quot;[System64Folder]WindowsPowerShell\v1.0\powershell.exe&quot; -NoProfile -NonInteractive -ExecutionPolicy Bypass -File &quot;[#IdentityRegistrationInvoker]&quot; -Action Unregister -Scope $(var.IdentityScope)"
                 Before="UnregisterIdentity" Sequence="execute" />
    <SetProperty Id="RollbackIdentity"
                 Value="&quot;[System64Folder]WindowsPowerShell\v1.0\powershell.exe&quot; -NoProfile -NonInteractive -ExecutionPolicy Bypass -File &quot;[#IdentityRegistrationInvoker]&quot; -Action Rollback -Scope $(var.IdentityScope)"
                 Before="RollbackIdentity" Sequence="execute" />
    <SetProperty Id="RegisterIdentity"
                 Value="&quot;[System64Folder]WindowsPowerShell\v1.0\powershell.exe&quot; -NoProfile -NonInteractive -ExecutionPolicy Bypass -File &quot;[#IdentityRegistrationInvoker]&quot; -Action Register -Scope $(var.IdentityScope)"
                 Before="RegisterIdentity" Sequence="execute" />

    <CustomAction Id="RollbackUnregisterIdentity" BinaryRef="Wix4UtilCA_X64"
                  DllEntry="WixQuietExec" Execute="rollback"
                  Impersonate="$(var.Impersonate)" Return="check" />
    <CustomAction Id="UnregisterIdentity" BinaryRef="Wix4UtilCA_X64"
                  DllEntry="WixQuietExec" Execute="deferred"
                  Impersonate="$(var.Impersonate)" Return="check" />
    <CustomAction Id="RollbackIdentity" BinaryRef="Wix4UtilCA_X64"
                  DllEntry="WixQuietExec" Execute="rollback"
                  Impersonate="$(var.Impersonate)" Return="check" />
    <CustomAction Id="RegisterIdentity" BinaryRef="Wix4UtilCA_X64"
                  DllEntry="WixQuietExec" Execute="deferred"
                  Impersonate="$(var.Impersonate)" Return="check" />
    <CustomAction Id="LaunchApplication" BinaryRef="Wix4UtilCA_X64"
                  DllEntry="WixUnelevatedShellExec" Execute="immediate"
                  Return="ignore" />

    <InstallExecuteSequence>
      <Custom Action="RollbackUnregisterIdentity" After="InstallInitialize"
              Condition="REMOVE~=&quot;ALL&quot;" />
      <Custom Action="UnregisterIdentity" After="RollbackUnregisterIdentity"
              Condition="REMOVE~=&quot;ALL&quot;" />
      <Custom Action="RollbackIdentity" After="InstallFiles"
              Condition="NOT Installed" />
      <Custom Action="RegisterIdentity" After="RollbackIdentity"
              Condition="NOT Installed OR REINSTALL" />
    </InstallExecuteSequence>

    <ui:WixUI Id="WixUI_Advanced" />
    <UIRef Id="WixUI_ErrorProgressText" />
    <WixVariable Id="WixUILicenseRtf" Value="$(var.EulaRtf)" />
    <UI>
      <Publish Dialog="ExitDialog" Control="Finish" Event="DoAction"
               Value="LaunchApplication"
               Condition="WIXUI_EXITDIALOGOPTIONALCHECKBOX = 1 AND NOT Installed" />
    </UI>
  </Package>
</Wix>
