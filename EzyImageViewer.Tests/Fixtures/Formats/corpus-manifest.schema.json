{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ezyimageviewer.local/schemas/format-corpus-v2.json",
  "title": "ezyImageViewer format corpus",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "minimumNormalPerExtension", "formats"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 2 },
    "minimumNormalPerExtension": { "type": "integer", "minimum": 30 },
    "formats": {
      "type": "array",
      "items": { "$ref": "#/$defs/format" }
    }
  },
  "$defs": {
    "format": {
      "type": "object",
      "additionalProperties": false,
      "required": ["extension", "format", "supportTier", "samples"],
      "properties": {
        "extension": { "type": "string", "pattern": "^\\.[a-z0-9]+$" },
        "format": {
          "enum": ["Jpeg", "Png", "Bmp", "Gif", "Tiff", "Ico", "WebP", "Avif", "Heif", "Svg"]
        },
        "supportTier": { "enum": ["official", "conditional"] },
        "samples": {
          "type": "array",
          "items": { "$ref": "#/$defs/sample" }
        }
      }
    },
    "sample": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "kind", "source", "license", "sha256"],
      "properties": {
        "path": { "$ref": "#/$defs/relativePath" },
        "kind": { "$ref": "#/$defs/sampleKind" },
        "source": { "type": "string", "minLength": 1 },
        "license": { "type": "string", "minLength": 1 },
        "sha256": { "$ref": "#/$defs/sha256" },
        "goldenPath": {
          "anyOf": [
            { "$ref": "#/$defs/relativePath" },
            { "type": "null" }
          ]
        },
        "goldenSha256": {
          "anyOf": [
            { "$ref": "#/$defs/sha256" },
            { "type": "null" }
          ]
        }
      }
    },
    "sampleKind": {
      "enum": ["normal", "large", "boundary", "corrupt", "security"]
    },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "not": { "pattern": "(^[A-Za-z]:)|(^[/\\\\])|((^|[/\\\\])\\.\\.($|[/\\\\]))" }
    },
    "sha256": {
      "type": "string",
      "pattern": "^[A-Fa-f0-9]{64}$"
    }
  }
}
