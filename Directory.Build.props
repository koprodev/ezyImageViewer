<Project>
  <PropertyGroup>
    <Product>ezy Image Viewer</Product>
    <Company>koprodev</Company>
    <Copyright>Copyright (c) 2026 koprodev</Copyright>
    <Version>0.1.0-m0</Version>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Deterministic>true</Deterministic>
    <AnalysisLevel>10.0</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>

  <!-- 제품과 설치 프로그램은 win-x64 전용. RID 그래프를 통일해 외부 게시 복원이 CI 잠금 파일을 망치지 않게 함. -->
  <PropertyGroup Condition="'$(MSBuildProjectExtension)' == '.csproj'">
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
  </PropertyGroup>

  <!-- MSIX 빌드는 전용 bin/obj 사용. 개발 출력물과 묵은 생성 코드가 끼어들 틈을 차단(ADR-0018). -->
  <PropertyGroup Condition="'$(Packaged)' == 'true'">
    <BaseOutputPath>bin\packaged\</BaseOutputPath>
    <BaseIntermediateOutputPath>obj\packaged\</BaseIntermediateOutputPath>
    <DefaultItemExcludes>$(DefaultItemExcludes);bin\**;obj\**</DefaultItemExcludes>
  </PropertyGroup>

  <!-- 외부 위치 ID는 게시자 결합 퓨전 매니페스트를 포함하므로 개발·MSIX 출력과 분리. -->
  <PropertyGroup Condition="'$(ExternalIdentity)' == 'true'">
    <BaseOutputPath>bin\external\</BaseOutputPath>
    <BaseIntermediateOutputPath>obj\external\</BaseIntermediateOutputPath>
    <DefaultItemExcludes>$(DefaultItemExcludes);bin\**;obj\**</DefaultItemExcludes>
  </PropertyGroup>

  <!-- ID 없는 포터블 미리보기는 전용 출력 사용. 패키지 ID·설치 매니페스트·개발 찌꺼기 상속 금지. -->
  <PropertyGroup Condition="'$(Portable)' == 'true'">
    <BaseOutputPath>bin\portable\</BaseOutputPath>
    <BaseIntermediateOutputPath>obj\portable\</BaseIntermediateOutputPath>
    <DefaultItemExcludes>$(DefaultItemExcludes);bin\**;obj\**</DefaultItemExcludes>
  </PropertyGroup>
</Project>
