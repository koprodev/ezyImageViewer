<Project>
  <PropertyGroup>
    <Product>ezy Image Viewer</Product>
    <Company>koprodev</Company>
    <Copyright>Copyright (c) 2026 koprodev</Copyright>
    <Version>0.1.0-m0</Version>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Deterministic>true</Deterministic>
    <AnalysisLevel>10.0</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>

  <!-- 제품은 win-x64 전용. RID 그래프를 통일해 CI 복원이 잠금 파일을 망치지 않게 함. -->
  <PropertyGroup Condition="'$(MSBuildProjectExtension)' == '.csproj'">
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
  </PropertyGroup>

  <!-- MSIX 빌드는 전용 bin/obj 사용. 개발 출력물과 묵은 생성 코드가 끼어들 틈을 차단(ADR-0018). -->
  <PropertyGroup Condition="'$(Packaged)' == 'true'">
    <BaseOutputPath>bin\packaged\</BaseOutputPath>
    <BaseIntermediateOutputPath>obj\packaged\</BaseIntermediateOutputPath>
    <DefaultItemExcludes>$(DefaultItemExcludes);bin\**;obj\**</DefaultItemExcludes>
  </PropertyGroup>

</Project>
